{
  "rewrites": [
    { "source": "/construction-company-ujjain", "destination": "/construction-company-ujjain/index.html" },
    { "source": "/interior-designer-ujjain", "destination": "/interior-designer-ujjain/index.html" },
    { "source": "/real-estate-ujjain", "destination": "/real-estate-ujjain/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/project/:path", "destination": "/index.html" },
    { "source": "/((?!assets|favicon|robots|sitemap|logo|icons|og-image).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
